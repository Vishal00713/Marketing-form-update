rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isBootstrappedAdmin() {
      return isSignedIn() && request.auth.token.email == 'vishalshrivastava.dss@gmail.com';
    }

    function isAdmin() {
      return isBootstrappedAdmin() || (
        isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidOrder(data) {
      return data.keys().hasAll(['id', 'createdAt', 'status', 'vendorName', 'city', 'blBoard']) &&
        data.id is string && data.id.size() <= 128 &&
        data.createdAt is string && data.createdAt.size() <= 64 &&
        data.status is string && data.status in ['pending', 'reviewing', 'approved', 'printing', 'completed', 'cancelled'] &&
        data.vendorName is string && data.vendorName.size() <= 200 &&
        data.city is string && data.city.size() <= 200 &&
        data.blBoard is string && data.blBoard.size() <= 200;
    }

    function isValidSetting(data) {
      return data.keys().hasAll(['id', 'businessName', 'formTitle']) &&
        data.id is string && data.id.size() <= 64 &&
        data.businessName is string && data.businessName.size() <= 200 &&
        data.formTitle is string && data.formTitle.size() <= 200;
    }

    // Connection test document
    match /test/connection {
      allow read: if true;
      allow write: if false;
    }

    // Admins collection
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isBootstrappedAdmin();
    }

    // Orders collection
    match /orders/{orderId} {
      // Anyone can look up a single order by exact order ID (for order tracking modal)
      allow get: if isValidId(orderId);
      
      // Only admins can query/list all orders
      allow list: if isAdmin();

      // Submitting new orders from client portal
      allow create: if isValidId(orderId) && isValidOrder(incoming());

      // Only admins can update or delete existing orders
      allow update: if isValidId(orderId) && isAdmin() && isValidOrder(incoming());
      allow delete: if isValidId(orderId) && isAdmin();
    }

    // App & portal settings
    match /settings/{settingId} {
      // App settings are publicly readable for displaying portal title, descriptions, and fields
      allow get: if isValidId(settingId);
      allow list: if true;

      // Only admins can update portal settings
      allow create, update: if isValidId(settingId) && isAdmin() && isValidSetting(incoming());
      allow delete: if isValidId(settingId) && isAdmin();
    }
  }
}
